# ORTA master environment template
# Copy to .env on the target server and fill in real secrets.
# NEVER commit real secrets. NEVER use placeholder values in production.

# ---------------------------------------------------------------------------
# Version pins (do not use "latest")
# ---------------------------------------------------------------------------
SEARXNG_IMAGE=searxng/searxng:2026.11.11-626105eec
RAGFLOW_IMAGE=infiniflow/ragflow:v1.0.0
RAGFLOW_VERSION=v1.0.0

ORTA_CORE_IMAGE=orta/core:1.0.0
ORTA_BRIDGE_IMAGE=orta/bridge:1.0.0
ORTA_UI_IMAGE=orta/ui:1.0.0

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# ---------------------------------------------------------------------------
# ORTA service URLs (internal Docker DNS)
# ---------------------------------------------------------------------------
ORTA_CORE_URL=http://orta-core:8000
ORTA_BRIDGE_URL=http://orta-bridge:8001
ORTA_UI_URL=http://orta-ui:3000

ORTA_SEARXNG_URL=http://searxng:8080
ORTA_RAGFLOW_URL=http://ragflow:9380

# ---------------------------------------------------------------------------
# Secrets (REPLACE with strong random values on the target server)
# ---------------------------------------------------------------------------
SEARXNG_SECRET=REPLACE_ME_searxng_secret_32_hex_bytes
POSTGRES_PASSWORD=REPLACE_ME_postgres_password
ORTA_DB_PASSWORD=REPLACE_ME_orta_db_password
REDIS_PASSWORD=REPLACE_ME_redis_password
RAGFLOW_DB_PASSWORD=REPLACE_ME_ragflow_db_password
RAGFLOW_API_KEY=REPLACE_ME_ragflow_api_key
MINIO_ROOT_USER=REPLACE_ME_minio_root_user
MINIO_ROOT_PASSWORD=REPLACE_ME_minio_root_password

# ---------------------------------------------------------------------------
# ORTA Core database (PostgreSQL in production; SQLite only for local dev)
# ---------------------------------------------------------------------------
ORTA_DATABASE_URL=postgresql+psycopg2://orta:${ORTA_DB_PASSWORD}@postgres:5432/orta

# ---------------------------------------------------------------------------
# RAGFlow
# ---------------------------------------------------------------------------
RAGFLOW_SECRET_KEY=REPLACE_ME_ragflow_secret_key
RAGFLOW_EMBEDDING_MODEL=REPLACE_ME_embedding_model_id

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ORTA_ENABLE_AUTH=false          # set true in production with real authN/authZ
ORTA_RATE_LIMIT_DEFAULT=2       # requests per second per source (default)
