# RAGFlow v1.0.0 environment template.
# Copy to .env on the target server and fill in real secrets.
# NEVER commit real secrets.

# RAGFlow image
RAGFLOW_IMAGE=infiniflow/ragflow:v1.0.0

# Ports
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381

# Database (MySQL)
MYSQL_IMAGE=mysql:8
MYSQL_ROOT_PASSWORD=REPLACE_ME_mysql_root_password
RAGFLOW_DB_PASSWORD=REPLACE_ME_ragflow_db_password
RAGFLOW_DB_USER=ragflow
RAGFLOW_DB_NAME=ragflow
MYSQL_DATABASE=ragflow

# Cache / queue (Valkey / Redis)
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=REPLACE_ME_redis_password

# Object storage (MinIO)
MINIO_IMAGE=minio/minio:RELEASE.2023-10-26T07-02-15Z
MINIO_ROOT_USER=REPLACE_ME_minio_root_user
MINIO_ROOT_PASSWORD=REPLACE_ME_minio_root_password
MINIO_BUCKET=ragflow

# Kvrocks (Go services cache)
KVROCKS_IMAGE=gresearch/kvrocks:latest

# Document engine (Elasticsearch or Infinity)
ELASTICSEARCH_IMAGE=elasticsearch:8.11.0

# RAGFlow secret
RAGFLOW_SECRET_KEY=REPLACE_ME_ragflow_secret_key

# Embedding model (configured at runtime via RAGFlow UI or provider API)
RAGFLOW_EMBEDDING_MODEL=REPLACE_ME_embedding_model_id

# Sandbox parsing (requires Docker socket access)
RAGFLOW_SANDBOX_ENABLED=true
